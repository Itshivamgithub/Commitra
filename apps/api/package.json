{
  "name": "@commitra/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node --max-old-space-size=256 dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "prisma": "^5.14.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@commitra/types": "workspace:*",
    "@prisma/client": "^5.14.0",
    "@sparticuz/chromium": "^148.0.0",
    "axios": "^1.6.8",
    "bullmq": "^5.77.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.39.0",
    "pino": "^9.1.0",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^25.0.4",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.7",
    "pino-pretty": "^11.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  }
}
